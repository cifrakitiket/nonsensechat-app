# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── VK Cloud S3 ───────────────────────────────────────────────────────────────
VK_S3_ENDPOINT=https://hb.vkcs.cloud
VK_S3_BUCKET=your-bucket-name
VK_S3_REGION=ru-msk
VK_S3_ACCESS_KEY=your_access_key
VK_S3_SECRET_KEY=your_secret_key
