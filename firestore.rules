rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMemberOf(chatId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // ── Пользователи ──
    // Профиль читает любой авторизованный, пишет только владелец.
    // Подколлекции (folders и т.п.) — только владелец.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Чаты ──
    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;

      // Сообщения: читать/обновлять — участники; создавать — участник от своего имени.
      match /messages/{msgId} {
        allow read: if isMemberOf(chatId);
        allow create: if isMemberOf(chatId) &&
          request.resource.data.uid == request.auth.uid;
        allow update: if isMemberOf(chatId);
      }

      // Сигнализация звонков (callSession/current + вложенные ICE-кандидаты).
      match /callSession/{document=**} {
        allow read, write: if isMemberOf(chatId);
      }

      // История звонков.
      match /callHistory/{document=**} {
        allow read, write: if isMemberOf(chatId);
      }
    }

    // ── Заявки в друзья ──
    match /friend_requests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // ── Стикерпаки ──
    // Читать может любой авторизованный (чтобы устанавливать чужие паки),
    // создавать/менять/удалять — только автор пака.
    match /stickerPacks/{packId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.authorUid == request.auth.uid;
    }
  }
}
