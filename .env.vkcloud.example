# ============================================================
# NonsenseChat — VK Cloud переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни своими значениями.
# НЕ коммить .env в git!

# --- PostgreSQL (VK Cloud) ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Пример: postgres://postgres:MyPass123@db.pscloud.mcs.mail.ru:5432/nonsensechat
VK_PG_URL=postgres://postgres:ПАРОЛЬ@ВАШ_ХОСТ.pscloud.mcs.mail.ru:5432/postgres

# --- Object Storage (VK Cloud S3) ---
VK_S3_ENDPOINT=https://hb.vkcs.cloud
VK_S3_BUCKET=nonsensechat-uploads
VK_S3_REGION=ru-msk
VK_S3_ACCESS=ВАШ_ACCESS_KEY_ID
VK_S3_SECRET=ВАШ_SECRET_ACCESS_KEY

# --- JWT Secret (придумай любую строку 32+ символа) ---
JWT_SECRET=ПРИДУМАЙ_СЛУЧАЙНУЮ_СТРОКУ_МИН_32_СИМВОЛА_1234567890abcdef

# --- Сервер ---
PORT=8787
HOST=0.0.0.0
